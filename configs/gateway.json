{
  "listen": "127.0.0.1:8080",
  "admin_path": "/__gateway",
  "drain_timeout": "30s",
  "release": {
    "min_successful_rehearsals": 1,
    "coverage": {
      "categories": [
        {
          "id": "healthchecks",
          "description": "健康检查类请求",
          "methods": ["GET", "HEAD"],
          "path_prefixes": ["/v1/health", "/v2/health"],
          "min_valid_samples": 1
        },
        {
          "id": "echo-reads",
          "description": "echo 读流量",
          "methods": ["GET"],
          "path_prefixes": ["/v1/echo/", "/v2/echo/"],
          "min_valid_samples": 2
        },
        {
          "id": "pay-traffic",
          "description": "支付高风险类别：总体平均值不能掩盖该类别缺口或失败",
          "methods": ["POST"],
          "path_prefixes": ["/v1/echo/", "/v2/echo/"],
          "header_name": "X-Biz",
          "header_value": "pay",
          "high_risk": true,
          "min_valid_samples": 1
        }
      ]
    }
  },
  "upstreams": [
    {
      "id": "local-v1",
      "base_url": "http://127.0.0.1:18081",
      "timeout": "10s"
    },
    {
      "id": "local-v2",
      "base_url": "http://127.0.0.1:18082",
      "timeout": "10s"
    }
  ],
  "routes": [
    {
      "id": "api-v2",
      "version": "v2",
      "prefix": "/v2/",
      "upstream_id": "local-v2",
      "strip_prefix": true,
      "retry": {
        "methods": ["GET", "HEAD"],
        "max_attempts": 2,
        "retry_on_status": [502, 503, 504],
        "retry_on_connect": true
      }
    },
    {
      "id": "api-v1",
      "version": "v1",
      "prefix": "/v1/",
      "upstream_id": "local-v1",
      "strip_prefix": true,
      "retry": {
        "methods": ["GET", "HEAD"],
        "max_attempts": 2,
        "retry_on_status": [502, 503, 504],
        "retry_on_connect": true
      }
    }
  ]
}
